{
  "manifest_version": 3,
  "name": "Transport Gaps — Friendly Transport Layer",
  "version": "0.6.0",
  "description": "A map-first Munich disruption explorer with demo transit locations, saved municipal footprints and a compact Google Maps companion.",
  "action": {
    "default_title": "Transport Gaps demo",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["munich-map.html"],
      "matches": ["https://www.google.com/*", "https://maps.google.com/*", "https://www.google.de/*", "https://www.google.co.uk/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/maps*",
        "https://maps.google.com/*",
        "https://www.google.de/maps*",
        "https://www.google.co.uk/maps*"
      ],
      "js": ["transit-data.js", "munich-highlights.js", "styles.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
