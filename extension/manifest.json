{
  "manifest_version": 3,
  "name": "Transport Gaps — Munich this morning",
  "version": "0.7.0",
  "description": "Daily Munich briefing of transport disruptions, strikes, protests, big events, roadworks and snow or rain, next to Google Maps.",
  "action": {
    "default_title": "Munich this morning",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["index.html", "munich-map.html"],
      "matches": ["https://www.google.com/*", "https://maps.google.com/*", "https://www.google.de/*", "https://www.google.co.uk/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/maps*",
        "https://maps.google.com/*",
        "https://www.google.de/maps*",
        "https://www.google.co.uk/maps*"
      ],
      "js": ["data/today.js", "companion.js"],
      "run_at": "document_idle"
    }
  ]
}
