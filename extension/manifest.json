{
  "manifest_version": 3,
  "name": "Transport Gaps — Friendly Transport Layer",
  "version": "0.2.0",
  "description": "A playful transport-awareness prototype with filters, colour-coded disruptions and a fictional rain layer. Not live or geo-anchored.",
  "action": {
    "default_title": "Transport Gaps demo",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/maps*",
        "https://maps.google.com/*",
        "https://www.google.de/maps*",
        "https://www.google.co.uk/maps*"
      ],
      "js": ["data.js", "styles.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
